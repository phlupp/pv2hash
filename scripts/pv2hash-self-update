#!/usr/bin/env bash
set -euo pipefail

INSTALL_INFO_FILE="/etc/pv2hash/install.env"
TAG="${1:-}"
PROBE_ONLY=0
WORKER_MODE=0
UPDATE_UNIT="pv2hash-self-update"

if [[ "${TAG}" == "--probe" ]]; then
    [[ "$#" -eq 1 ]] || { echo "Ungültige Probe-Argumente." >&2; exit 2; }
    PROBE_ONLY=1
    TAG=""
elif [[ "${TAG}" == "--worker" ]]; then
    [[ "$#" -eq 2 ]] || { echo "Ungültige Worker-Argumente." >&2; exit 2; }
    WORKER_MODE=1
    TAG="$2"
else
    [[ "$#" -eq 1 ]] || { echo "Ein Release-Tag ist erforderlich." >&2; exit 2; }
fi

fail() {
    echo "$*" >&2
    exit 1
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        fail "Der Update-Helper muss als root laufen."
    fi
}

require_command() {
    local cmd="$1"
    command -v "${cmd}" >/dev/null 2>&1 || fail "Benötigtes Kommando fehlt: ${cmd}"
}

parse_install_info() {
    [[ -f "${INSTALL_INFO_FILE}" ]] || fail "Installationsinfo fehlt: ${INSTALL_INFO_FILE}"
    # shellcheck disable=SC1090
    source "${INSTALL_INFO_FILE}"
    # Installationsdaten von v0.7.x dürfen weiterhin auf get.pv2hash.xyz zeigen.
    if [[ "${PV2HASH_UPDATE_BASE_URL:-}" == "https://get.pv2hash.xyz" ]]; then
        PV2HASH_UPDATE_BASE_URL="https://api.github.com/repos/phlupp/pv2hash"
    fi

    APP_ROOT="${PV2HASH_APP_ROOT:-/opt/pv2hash}"
    DATA_DIR="${PV2HASH_DATA_DIR:-/var/lib/pv2hash/data}"
    DATA_ROOT="$(dirname "${DATA_DIR}")"
    LOG_DIR="${DATA_ROOT}/logs"
    STATE_FILE="${DATA_DIR}/self_update_status.json"
    LOCK_DIR="${DATA_DIR}/self_update.lock"
    LOCK_PID_FILE="${LOCK_DIR}/pid"
    APP_USER_NAME="${PV2HASH_APP_USER:-pv2hash}"
    APP_GROUP_NAME="${PV2HASH_APP_GROUP:-pv2hash}"
    INSTALL_SCRIPT="${APP_ROOT}/current/scripts/install_release.sh"
    SELF_UPDATE_LOG="${LOG_DIR}/self_update.log"

    [[ "${PV2HASH_INSTALL_MODE:-}" == "release" ]] || fail "Update über die Weboberfläche ist nur für Release-Installationen verfügbar."
    [[ -x "${INSTALL_SCRIPT}" ]] || fail "Release-Installer nicht gefunden: ${INSTALL_SCRIPT}"

    mkdir -p "${DATA_DIR}" "${LOG_DIR}"
    chown -R "${APP_USER_NAME}:${APP_GROUP_NAME}" "${DATA_DIR}" "${LOG_DIR}" || true
}

tag_to_version_full() {
    local raw="$1"
    if [[ "${raw}" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return 0
    fi
    if [[ "${raw}" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+)-build\.([0-9]+)$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

write_state() {
    local status="$1"
    local message="$2"
    local finished_at="$3"
    local last_error="$4"
    local updated_version_full="$5"
    local target_version_full=""

    if [[ -n "${TAG}" ]]; then
        target_version_full="$(tag_to_version_full "${TAG}" 2>/dev/null || true)"
    fi

    STATE_STATUS="${status}" \
    STATE_MESSAGE="${message}" \
    STATE_TARGET_TAG="${TAG}" \
    STATE_TARGET_VERSION_FULL="${target_version_full}" \
    STATE_STARTED_AT="${STARTED_AT}" \
    STATE_FINISHED_AT="${finished_at}" \
    STATE_LAST_ERROR="${last_error}" \
    STATE_UPDATED_VERSION_FULL="${updated_version_full}" \
    STATE_HELPER_PATH="$0" \
    STATE_LOG_FILE="${SELF_UPDATE_LOG}" \
    python3 - "${STATE_FILE}" <<'PY'
import json
import os
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

payload = {
    "status": os.environ.get("STATE_STATUS", "idle"),
    "message": os.environ.get("STATE_MESSAGE", ""),
    "target_tag": os.environ.get("STATE_TARGET_TAG") or None,
    "target_version_full": os.environ.get("STATE_TARGET_VERSION_FULL") or None,
    "started_at": os.environ.get("STATE_STARTED_AT") or None,
    "finished_at": os.environ.get("STATE_FINISHED_AT") or None,
    "last_error": os.environ.get("STATE_LAST_ERROR") or None,
    "updated_version_full": os.environ.get("STATE_UPDATED_VERSION_FULL") or None,
    "helper_path": os.environ.get("STATE_HELPER_PATH") or None,
    "log_file": os.environ.get("STATE_LOG_FILE") or None,
    "written_at": datetime.now(UTC).isoformat(),
}

path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
# Never expose a truncated JSON status if the worker is interrupted.
temp_name = None
try:
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent,
        prefix=".self-update-state-", delete=False,
    ) as tmp:
        temp_name = tmp.name
        json.dump(payload, tmp, indent=2, ensure_ascii=False)
        tmp.flush()
        os.fsync(tmp.fileno())
    os.chmod(temp_name, 0o644)
    os.replace(temp_name, path)
finally:
    if temp_name and os.path.exists(temp_name):
        os.unlink(temp_name)
PY

    chown "${APP_USER_NAME}:${APP_GROUP_NAME}" "${STATE_FILE}" || true
}

cleanup_stale_lock() {
    [[ -d "${LOCK_DIR}" ]] || return 0

    local pid=""
    if [[ -f "${LOCK_PID_FILE}" ]]; then
        pid="$(cat "${LOCK_PID_FILE}" 2>/dev/null || true)"
    fi

    # A previous PID may have been reused by an unrelated process. Treat an
    # existing PID as our worker only if its argv still refers to this helper.
    if [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null; then
        local args=""
        if [[ -r "/proc/${pid}/cmdline" ]]; then
            args="$(tr '\0' '\n' < "/proc/${pid}/cmdline" || true)"
        fi
        if [[ "${args}" == *"${BASH_SOURCE[0]}"* && "${args}" == *"--worker"* ]]; then
            fail "Es läuft bereits ein Update."
        fi
    fi

    rm -rf "${LOCK_DIR}"
}

acquire_lock() {
    cleanup_stale_lock

    if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
        fail "Es läuft bereits ein Update."
    fi

    printf '%s\n' "$$" > "${LOCK_PID_FILE}"
}

release_lock() {
    rm -rf "${LOCK_DIR}" 2>/dev/null || true
}

handle_stop() {
    local signal="$1"
    trap - HUP INT TERM
    write_state "error" "Update-Worker wurde durch Signal ${signal} unterbrochen." \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "Signal ${signal}" "" || true
    exit 143
}

verify_worker_unit() {
    # The sudoers rule historically permits arguments to the helper. Do not
    # allow "--worker" to bypass the isolated service by calling sudo directly.
    require_command systemctl
    local unit_pid=""
    unit_pid="$(systemctl show --property=MainPID --value "${UPDATE_UNIT}.service" 2>/dev/null || true)"
    [[ "${unit_pid}" == "$$" ]] || fail "Update-Worker muss in seiner eigenen systemd-Unit laufen."
}

dispatch_update() {
    require_command systemd-run
    # A transient service gets its OWN systemd cgroup. 'setsid' alone cannot
    # protect a child of pv2hash.service from KillMode=control-group on restart.
    # A fixed unit name additionally prevents two concurrent dispatches.
    systemd-run --quiet --collect --service-type=exec \
        --unit="${UPDATE_UNIT}" --property=RuntimeMaxSec=1800 \
        "${BASH_SOURCE[0]}" --worker "${TAG}"
}

main() {
    require_root
    require_command python3
    parse_install_info

    if [[ "${PROBE_ONLY}" -eq 1 ]]; then
        require_command systemd-run
        exit 0
    fi

    [[ -n "${TAG}" ]] || fail "Release-Tag fehlt."
    tag_to_version_full "${TAG}" >/dev/null || fail "Ungültiges Release-Tag: ${TAG}"

    if [[ "${WORKER_MODE}" -eq 0 ]]; then
        dispatch_update
        exit 0
    fi

    verify_worker_unit
    STARTED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    acquire_lock
    trap release_lock EXIT
    trap 'handle_stop TERM' TERM
    trap 'handle_stop INT' INT
    trap 'handle_stop HUP' HUP

    write_state "running" "Update auf $(tag_to_version_full "${TAG}") läuft …" "" "" ""

    set +e
    {
        echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Starte Update auf ${TAG}"
        PV2HASH_UPDATE_BASE_URL="${PV2HASH_UPDATE_BASE_URL:-https://api.github.com/repos/phlupp/pv2hash}" \
        PV2HASH_UPDATE_CHANNEL="${PV2HASH_UPDATE_CHANNEL:-stable}" \
        TAG="${TAG}" \
        APP_ROOT="${APP_ROOT}" \
        DATA_ROOT="${DATA_ROOT}" \
        HOST="${PV2HASH_HOST:-0.0.0.0}" \
        PORT="${PV2HASH_PORT:-8000}" \
        PV2HASH_UPDATE_PHASE_FILE="${DATA_DIR}/self_update_phase.json" \
        PV2HASH_UPDATE_PHASE_TAG="${TAG}" \
        PV2HASH_UPDATE_STARTED_AT="${STARTED_AT}" \
        bash "${INSTALL_SCRIPT}"
    } >> "${SELF_UPDATE_LOG}" 2>&1
    rc=$?
    set -e

    if [[ "${rc}" -eq 0 ]]; then
        # shellcheck disable=SC1090
        source "${INSTALL_INFO_FILE}" || true
        write_state \
            "success" \
            "Update erfolgreich installiert. Dienst wurde neu gestartet." \
            "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
            "" \
            "${PV2HASH_VERSION:-}"
        exit 0
    fi

    error_tail="$(tail -n 20 "${SELF_UPDATE_LOG}" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
    write_state \
        "error" \
        "Update ist fehlgeschlagen. Details siehe Update-Log." \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
        "${error_tail}" \
        ""
    exit "${rc}"
}

main "$@"
